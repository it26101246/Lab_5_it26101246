#include <stdio.h>
int main (void)
{
	int n = 1;
	char CS;

	printf("Enter the curent state of the order:");
	scanf("%c", &CS);

	if(CS==V)
	{
	     printf("Processing order %d",n);
	     n = n + 1;
             continue;
	}

        if (CS==I)
        {

             printf("Skipping order %d", n);
	     n = n + 1;
             continue;

	}

	if (CS==S)
        {
		printf("Stopping order %d", n);
		break;
	}

	return 0;

}


